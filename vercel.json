{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": { "runtime": "vercel-php@0.9.0", "maxDuration": 60 }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1",
      "headers": { "Cache-Control": "public, max-age=86400" }
    },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
